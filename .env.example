# Copy to .env and edit. Dry-run is the default and does not spend money.

DRY_RUN=true
REQUIRE_LIVE_CONFIRM=true
# LIVE_CONFIRM_TOKEN=I_ACCEPT_LIVE_RISK

MIN_MARGIN_PCT=15
MAX_FUNPAY_PRICE=5000
PRICE_SLIPPAGE_PCT=3
MIN_TITLE_SIMILARITY=0.55

MAX_CONCURRENT_DEALS=5
MAX_DEALS_PER_HOUR=20
STUCK_DEAL_MINUTES=60
WELCOME_COOLDOWN_SECONDS=120
POLL_INTERVAL_SECONDS=6

# Comma-separated Playerok lot ids (if set, keywords are ignored)
PLAYEROK_LOT_IDS=
WATCH_KEYWORDS=steam,nitro,robux,spotify

# Live credentials — leave empty while DRY_RUN=true
FUNPAY_GOLDEN_KEY=
PLAYEROK_TOKEN=

# Optional Telegram operator alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

HOST=127.0.0.1
PORT=43147
# DB_PATH=data/deals.db
# LOG_DIR=logs
